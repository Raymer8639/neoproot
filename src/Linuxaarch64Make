VPATH := $(dir $(lastword $(MAKEFILE_LIST)))
SRC    = $(dir $(firstword $(MAKEFILE_LIST)))

GIT      = git
RM       = rm
INSTALL  = install
CC       ?= gcc
LD       = $(CC)
STRIP    ?= strip
OBJCOPY  ?= objcopy
OBJDUMP  ?= objdump

# 核心：禁用未定义符号相关功能 + 跨平台兼容宏 + 头文件路径
CPPFLAGS += \
	-D_FILE_OFFSET_BITS=64 \
	-D_GNU_SOURCE \
	-I. -I$(VPATH) \
	-DDISABLE_ASHMEM_MEMFD \
	-DDISABLE_LOADER_INTERNAL \
	-DDISABLE_POKEDATA_WORKAROUND \
	-D__fmt_llu="%lu"  # 统一rlim64_t打印格式，解决跨平台格式符警告

# 编译优化 + 全量跨平台警告屏蔽
# 屏蔽strncpy截断、无符号数比较、格式符不匹配等Termux/Linux编译警告
CFLAGS   += -Wall -Wextra -O2 \
	-Wno-stringop-truncation \
	-Wno-type-limits \
	-Wno-format \
	-Wno-stringop-overflow \
	-Wno-implicit-fallthrough

# 链接依赖：talloc库 + 关闭栈执行（安全兼容）
LDFLAGS  += -ltalloc -Wl,-z,noexecstack

