VPATH := $(dir $(lastword $(MAKEFILE_LIST)))
SRC    = $(dir $(firstword $(MAKEFILE_LIST)))

GIT      = git
RM       = rm
INSTALL  = install
CC       ?= gcc
LD       = $(CC)
STRIP    ?= strip
OBJCOPY  ?= objcopy
OBJDUMP  ?= objdump

# 关键：禁用所有会导致未定义符号的功能
# 新增：添加跨平台兼容宏，解决格式符警告
CPPFLAGS += \
	-D_FILE_OFFSET_BITS=64 \
	-D_GNU_SOURCE \
	-I. -I$(VPATH) \
	-DDISABLE_ASHMEM_MEMFD \
	-DDISABLE_LOADER_INTERNAL \
	-DDISABLE_POKEDATA_WORKAROUND \
	-D__fmt_llu="%lu"  # 【新增】统一 rlim64_t 打印格式

# 关键：保留原有优化，新增全量警告屏蔽
# 屏蔽了 strncpy截断、无符号数比较、格式符不匹配等所有跨平台警告
CFLAGS   += -Wall -Wextra -O2 \
	-Wno-stringop-truncation \
	-Wno-type-limits \
	-Wno-format \
	-Wno-stringop-overflow \
	-Wno-implicit-fallthrough

LDFLAGS  += -ltalloc -Wl,-z,noexecstack

