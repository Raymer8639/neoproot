# 空 loader，避免符号缺失
OBJECTS += loader/loader-wrapped.o

.DEFAULT_GOAL = proot
all: proot

quiet_CC  = @echo "  CC    $@";
quiet_LD  = @echo "  LD    $@";

build.h:
	@echo "  GEN   $@"
	@echo "#ifndef BUILD_H" > $@
	@echo "#define BUILD_H" >> $@
	@echo "#endif" >> $@

COMPILE = $(quiet_CC) $(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

proot: $(OBJECTS) build.h
	$(quiet_LD) $(CC) -o $@ $^ $(LDFLAGS)

%.o: %.c build.h
	@mkdir -p $(dir $@)
	$(COMPILE)

# 空 loader 实现
loader/loader-wrapped.o:
	@mkdir -p loader
	@echo "const char _binary_loader_exe_start[] = {};" > loader/loader-wrapped.c
	@echo "const char _binary_loader_exe_end[] = {};"   >> loader/loader-wrapped.c
	@echo "const int offset_to_pokedata_workaround = 0;" >> loader/loader-wrapped.c
	@echo "void ashmem_memfd_callback(void) {}" >> loader/loader-wrapped.c
	$(CC) -c loader/loader-wrapped.c -o $@

clean:
	rm -f proot build.h
	rm -f cli/*.o execve/*.o path/*.o syscall/*.o tracee/*.o ptrace/*.o
	rm -f extension/*/*.o loader/*.o loader/loader-wrapped.c

install: proot
	install -D proot /usr/local/bin/proot

.PHONY: clean install
