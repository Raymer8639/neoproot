# 空loader目标文件：解决所有未定义符号引用（核心修复）
OBJECTS += loader/loader-wrapped.o

# 默认编译目标：生成proot可执行文件
.DEFAULT_GOAL = proot
all: proot

# 编译/链接日志打印前缀
quiet_CC  = @echo "  CC    $@";
quiet_LD  = @echo "  LD    $@";

# 自动生成build.h头文件（PRoot编译依赖）
build.h:
	@echo "  GEN   $@"
	@echo "#ifndef BUILD_H" > $@
	@echo "#define BUILD_H" >> $@
	@echo "#endif" >> $@

# 通用编译规则：.c → .o
COMPILE = $(quiet_CC) $(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# 链接生成proot主程序
proot: $(OBJECTS) build.h
	$(quiet_LD) $(CC) -o $@ $^ $(LDFLAGS)

# 目标文件依赖：所有.o依赖对应.c和build.h
%.o: %.c build.h
	@mkdir -p $(dir $@)
	$(COMPILE)

# 空loader实现：修复ssize_t未定义+解决2个核心未定义符号
# 新增#include <sys/types.h> 引入ssize_t类型定义，Termux/Linux通用
loader/loader-wrapped.o:
	@mkdir -p loader
	@echo "#include <sys/types.h>" > loader/loader-wrapped.c
	@echo "const char _binary_loader_exe_start[] = {};" >> loader/loader-wrapped.c
	@echo "const char _binary_loader_exe_end[] = {};"   >> loader/loader-wrapped.c
	@echo "const ssize_t offset_to_pokedata_workaround = 0;" >> loader/loader-wrapped.c
	@echo "void ashmem_memfd_callback(void) {}" >> loader/loader-wrapped.c
	$(CC) -c loader/loader-wrapped.c -o $@

# 清理编译产物：删除可执行文件+目标文件+自动生成的源码
clean:
	rm -f proot build.h
	rm -f cli/*.o execve/*.o path/*.o syscall/*.o tracee/*.o ptrace/*.o
	rm -f extension/*/*.o loader/*.o loader/loader-wrapped.c

# 安装proot：拷贝到系统全局目录/usr/local/bin（Termux/Linux通用）
install: proot
	install -D proot /usr/local/bin/proot

# 声明伪目标：避免与同名文件冲突
.PHONY: clean install
